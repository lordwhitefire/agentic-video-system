# Copy to .env (gitignored) and fill in. The runtime loads this automatically.
# Priority: OPENAI_BASE_URL > GLM_API_KEY (Zhipu) > api.openai.com

# Zhipu (BigModel) — free tier model glm-4-flash
GLM_API_KEY=

# OR an OpenAI-compatible endpoint (Azure OpenAI, vLLM, LM Studio, ...)
# OPENAI_BASE_URL=https://your-endpoint/v1
# OPENAI_API_KEY=

# Optional model override (defaults: glm-4.5-flash for Zhipu, gpt-4o-mini otherwise)
# AVIS_LLM_MODEL=

# Set to 0 to disable LLM thinking (fast deterministic scripted brain)
# AVIS_LLM_ENABLED=1